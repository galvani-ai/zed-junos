set version 21.4R3.15
set system host-name r1
set system services ssh root-login deny
set interfaces ge-0/0/0 description "Uplink core-1"
set interfaces ge-0/0/0 unit 0 family inet address 192.0.2.1/30
set interfaces ge-0/0/0 unit 0 family inet6 address 2001:db8::1/64
deactivate interfaces ge-0/0/1
set policy-options policy-statement EXPORT-BGP term LOOPBACK then community set CUST
set policy-options policy-statement EXPORT-BGP term LOOPBACK then accept
set firewall family inet filter PROTECT-RE term SSH from destination-port [ ssh netconf ]
delete protocols ospf

[edit interfaces]
set lo0 unit 0 family inet address 10.255.0.1/32
